<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.barana.LoginController">
   <children>
      <TextField fx:id="userNameInput" layoutX="164.0" layoutY="175.0" prefHeight="39.0" prefWidth="360.0">
         <font>
            <Font size="18.0" />
         </font>
      </TextField>
      <Label layoutX="60.0" layoutY="181.0" text="Username :">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="loginButton" layoutX="63.0" layoutY="239.0" mnemonicParsing="false" onAction="#login" prefHeight="39.0" prefWidth="464.0" text="LOG IN">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <ProgressBar fx:id="progressBar" layoutX="14.0" layoutY="322.0" prefHeight="18.0" prefWidth="576.0" progress="0.0" />
      <Label fx:id="errorMassege" layoutX="63.0" layoutY="290.0" prefHeight="17.0" prefWidth="464.0" textFill="#eb0d0d">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
